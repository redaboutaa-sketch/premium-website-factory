---
import config from 'virtual:factory/config';
import Base from '../../layouts/Base.astro';

const contact = config.facts['contact.email']?.value;
---

<Base title={`${config.brand} — procurement consulting (demo)`} lang="en" path="/en/">
  <h1>{config.brand}</h1>
  <p>Procurement consulting for industrial SMEs. Temporary page: the art direction is being chosen.</p>
  {typeof contact === 'string' && <p>Contact: <a href={`mailto:${contact}`}>{contact}</a></p>}
  <p><a href="/" hreflang="fr" lang="fr">Français</a></p>
</Base>
